{
  "name": "pos-system",
  "version": "1.0.0",
  "description": "Abeywickrama Super Mart - Offline POS System",
  "main": "electron/main.js",
  "scripts": {
    "dev:react": "vite",
    "dev:server": "node server/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:react\"",
    "build": "vite build",
    "start": "electron .",
    "electron:dev": "concurrently \"npm run dev:server\" \"npm run dev:react\" \"wait-on http://localhost:5173 && electron .\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "axios": "^1.7.0",
    "chart.js": "^4.4.0",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "electron-is-dev": "^2.0.0",
    "express": "^4.18.0",
    "mongoose": "^8.5.0",
    "node-thermal-printer": "^4.4.0",
    "react": "^18.3.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.0",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.26.0",
    "react-toastify": "^10.0.0",
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "vite": "^5.4.0"
  }
}
